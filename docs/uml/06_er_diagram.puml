@startuml 06_er_diagram
skinparam defaultFontName "Noto Sans CJK TC"
skinparam shadowing false
skinparam backgroundColor white
title 投稿審查系統 - 資料庫 ER 圖 (PostgreSQL: mydb)
hide circle
skinparam linetype ortho
entity users {
  * id : varchar(15) <<PK>>
  --
  * pwd : varchar(30)
  * nickname : varchar(30)
  * role : varchar(10) CHECK(author/editor)
}
entity articles {
  * aid : serial <<PK>>
  --
  * author : varchar(15) <<FK → users.id>>
  * category : varchar(20)
  * title : varchar(100)
  * content : text
  * status : varchar(10) CHECK(編輯中/審查中/已通過)
  * updated_at : timestamp
}
users ||--o{ articles : 撰寫
@enduml
