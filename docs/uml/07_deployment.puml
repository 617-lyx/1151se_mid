@startuml 07_deployment
skinparam defaultFontName "Noto Sans CJK TC"
skinparam shadowing false
skinparam backgroundColor white
title 投稿審查系統 - 部署圖 (Deployment Diagram)
node "使用者電腦" {
  node "瀏覽器" {
    artifact "HTML 頁面\n(Jinja2 產生 / www 靜態檔)" as FE
  }
  node "Python (uvicorn)" {
    component "FastAPI 伺服器\nmain.py\nport 8000" as API
    component "routes/\nlogin, author, editor" as R
  }
  database "PostgreSQL\nport 5432\n資料庫 mydb" as DB
}
FE --> API : HTTP GET / POST\n(表單送出、頁面請求)
API --> R
R --> DB : SQL (psycopg)
@enduml
