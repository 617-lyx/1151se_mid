@startuml 02_class_diagram
skinparam defaultFontName "Noto Sans CJK TC"
skinparam shadowing false
skinparam backgroundColor white
title 投稿審查系統 - 類別圖 (Class Diagram)
skinparam classAttributeIconSize 0

package "main.py" {
  class FastAPI_app <<FastAPI>> {
    + SessionMiddleware
    + include_router(login, "/user")
    + include_router(author, "/author")
    + include_router(editor, "/editor")
    + mount("/w", StaticFiles("www"))
    + GET / : home()
    + httpError(exc)
  }
}

package "routes" {
  class "login.py" as LoginRouter <<APIRouter>> {
    + POST /user/login : login()
    + GET  /user/logout : logout()
    + POST /user/register : register()
  }
  class "author.py" as AuthorRouter <<APIRouter>> {
    + GET  /author/list : myList()
    + GET  /author/new : newForm()
    + POST /author/add : add()
    + GET  /author/edit/{aid} : editForm()
    + POST /author/update : update()
    + POST /author/delete/{aid} : delete()
    + POST /author/submit/{aid} : submit()
    + GET  /author/view/{aid} : view()
    - checkForm(category, title, content)
  }
  class "editor.py" as EditorRouter <<APIRouter>> {
    + GET  /editor/list : reviewList()
    + GET  /editor/view/{aid} : view()
    + POST /editor/pass/{aid} : approve()
    + POST /editor/reject/{aid} : reject()
  }
}

class "auth.py" as Auth {
  + chkLogin(role) : checker
}
class "db.py" as DB {
  + DB_URL : str
  + lifespan(app)
  + getDB(request) : AsyncConnection
}
class "common.py" as Common {
  + templates : Jinja2Templates
  + CATEGORIES : list
  + flash(request, msg, ok)
}

package "資料表 (PostgreSQL)" {
  class users <<table>> {
    + id : varchar(15) <<PK>>
    + pwd : varchar(30)
    + nickname : varchar(30)
    + role : author | editor
  }
  class articles <<table>> {
    + aid : serial <<PK>>
    + author : varchar(15) <<FK>>
    + category : varchar(20)
    + title : varchar(100)
    + content : text
    + status : 編輯中 | 審查中 | 已通過
    + updated_at : timestamp
  }
}

FastAPI_app --> LoginRouter
FastAPI_app --> AuthorRouter
FastAPI_app --> EditorRouter
FastAPI_app ..> DB : lifespan
AuthorRouter ..> Auth : Depends
EditorRouter ..> Auth : Depends
LoginRouter ..> DB : Depends(getDB)
AuthorRouter ..> DB : Depends(getDB)
EditorRouter ..> DB : Depends(getDB)
AuthorRouter ..> Common
EditorRouter ..> Common
DB ..> users : SQL
DB ..> articles : SQL
users "1" -- "0..*" articles : 撰寫 >
@enduml
